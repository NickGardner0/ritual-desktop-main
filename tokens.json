{
  "$schema": "https://www.designtokens.org/tr/drafts/format/",
  "$description": "Ritual design tokens. Root reference files remain standalone; production components consume the synchronized semantic contract from @ritual/ui.",
  "primitive": {
    "color": {
      "neutral": {
        "0": { "$value": "#ffffff", "$type": "color", "$description": "Pure white, reserved for raised surfaces and inverse text." },
        "25": { "$value": "#fefefe", "$type": "color", "$description": "Primary light canvas." },
        "50": { "$value": "#fbfcfb", "$type": "color", "$description": "Subtle warm-white surface." },
        "75": { "$value": "#f7f8f5", "$type": "color", "$description": "Recessed content surface." },
        "100": { "$value": "#f4f4f3", "$type": "color", "$description": "Panel surface." },
        "150": { "$value": "#eeeeec", "$type": "color", "$description": "Hover and selected fill." },
        "200": { "$value": "#e7e5dd", "$type": "color", "$description": "Warm separator and stronger border." },
        "300": { "$value": "#dad9d7", "$type": "color", "$description": "Default hairline border." },
        "400": { "$value": "#9a9a94", "$type": "color", "$description": "Muted text in dark mode and disabled content." },
        "500": { "$value": "#7a7a7a", "$type": "color", "$description": "Muted text." },
        "600": { "$value": "#666666", "$type": "color", "$description": "Secondary text." },
        "700": { "$value": "#5f6368", "$type": "color", "$description": "Default icon color." },
        "800": { "$value": "#27251e", "$type": "color", "$description": "Warm graphite for strong controls." },
        "900": { "$value": "#111111", "$type": "color", "$description": "Primary light-theme text." },
        "950": { "$value": "#0b0b0c", "$type": "color", "$description": "Primary dark canvas." }
      },
      "chromatic": {
        "teal": { "$value": "#306774", "$type": "color", "$description": "Ritual accent and informational emphasis." },
        "teal-strong": { "$value": "#24515c", "$type": "color", "$description": "Pressed or high-contrast teal." },
        "green": { "$value": "#167046", "$type": "color", "$description": "Positive and completed state." },
        "amber": { "$value": "#b45309", "$type": "color", "$description": "Attention and warning state." },
        "red": { "$value": "#9f2d20", "$type": "color", "$description": "Destructive and error state." },
        "blue": { "$value": "#2563eb", "$type": "color", "$description": "Link or informational fallback when teal is unsuitable." }
      },
      "alpha": {
        "black-3": { "$value": "rgba(17, 24, 39, 0.032)", "$type": "color", "$description": "Light row hover." },
        "black-5": { "$value": "rgba(15, 23, 42, 0.052)", "$type": "color", "$description": "Subtle light border." },
        "black-8": { "$value": "rgba(15, 23, 42, 0.08)", "$type": "color", "$description": "Strong light border." },
        "white-6": { "$value": "rgba(255, 255, 255, 0.06)", "$type": "color", "$description": "Muted dark border." },
        "white-8": { "$value": "rgba(255, 255, 255, 0.08)", "$type": "color", "$description": "Subtle dark border." },
        "white-10": { "$value": "rgba(255, 255, 255, 0.10)", "$type": "color", "$description": "Dark control surface." },
        "white-16": { "$value": "rgba(255, 255, 255, 0.16)", "$type": "color", "$description": "Dark control hover." }
      }
    },
    "fontFamily": {
      "sans": { "$value": ["FK Grotesk Neue", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"], "$type": "fontFamily", "$description": "Primary product typeface." },
      "native": { "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"], "$type": "fontFamily", "$description": "Native chrome and platform controls." },
      "mono": { "$value": ["SFMono-Regular", "SF Mono", "Menlo", "Monaco", "Consolas", "monospace"], "$type": "fontFamily", "$description": "Code, identifiers, and technical metadata." }
    },
    "fontWeight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" }
    },
    "dimension": {
      "0": { "$value": "0px", "$type": "dimension" },
      "1": { "$value": "1px", "$type": "dimension" },
      "2": { "$value": "2px", "$type": "dimension" },
      "4": { "$value": "4px", "$type": "dimension" },
      "6": { "$value": "6px", "$type": "dimension" },
      "8": { "$value": "8px", "$type": "dimension" },
      "10": { "$value": "10px", "$type": "dimension" },
      "12": { "$value": "12px", "$type": "dimension" },
      "16": { "$value": "16px", "$type": "dimension" },
      "20": { "$value": "20px", "$type": "dimension" },
      "24": { "$value": "24px", "$type": "dimension" },
      "28": { "$value": "28px", "$type": "dimension" },
      "32": { "$value": "32px", "$type": "dimension" },
      "36": { "$value": "36px", "$type": "dimension" },
      "40": { "$value": "40px", "$type": "dimension" },
      "44": { "$value": "44px", "$type": "dimension" },
      "48": { "$value": "48px", "$type": "dimension" },
      "64": { "$value": "64px", "$type": "dimension" }
    },
    "duration": {
      "instant": { "$value": "0ms", "$type": "duration" },
      "fast": { "$value": "100ms", "$type": "duration" },
      "normal": { "$value": "160ms", "$type": "duration" },
      "slow": { "$value": "240ms", "$type": "duration" }
    },
    "cubicBezier": {
      "standard": { "$value": [0.2, 0, 0, 1], "$type": "cubicBezier" },
      "exit": { "$value": [0.4, 0, 1, 1], "$type": "cubicBezier" }
    }
  },
  "semantic": {
    "light": {
      "color": {
        "background": { "$value": "{primitive.color.neutral.25}", "$type": "color" },
        "foreground": { "$value": "{primitive.color.neutral.900}", "$type": "color" },
        "surface": {
          "canvas": { "$value": "{primitive.color.neutral.25}", "$type": "color" },
          "content": { "$value": "{primitive.color.neutral.25}", "$type": "color" },
          "raised": { "$value": "{primitive.color.neutral.0}", "$type": "color" },
          "panel": { "$value": "{primitive.color.neutral.100}", "$type": "color" },
          "recessed": { "$value": "{primitive.color.neutral.75}", "$type": "color" },
          "control": { "$value": "rgba(255, 255, 255, 0.42)", "$type": "color" },
          "control-hover": { "$value": "rgba(255, 255, 255, 0.58)", "$type": "color" },
          "sidebar": { "$value": "rgba(255, 255, 255, 0.34)", "$type": "color" },
          "chrome": { "$value": "rgba(255, 255, 255, 0.46)", "$type": "color" }
        },
        "text": {
          "primary": { "$value": "{primitive.color.neutral.900}", "$type": "color" },
          "secondary": { "$value": "{primitive.color.neutral.600}", "$type": "color" },
          "muted": { "$value": "{primitive.color.neutral.500}", "$type": "color" },
          "inverse": { "$value": "{primitive.color.neutral.0}", "$type": "color" },
          "link": { "$value": "{primitive.color.chromatic.teal}", "$type": "color" }
        },
        "border": {
          "default": { "$value": "{primitive.color.neutral.300}", "$type": "color" },
          "subtle": { "$value": "{primitive.color.alpha.black-5}", "$type": "color" },
          "muted": { "$value": "rgba(15, 23, 42, 0.035)", "$type": "color" },
          "strong": { "$value": "{primitive.color.alpha.black-8}", "$type": "color" }
        },
        "icon": {
          "default": { "$value": "{primitive.color.neutral.700}", "$type": "color" },
          "muted": { "$value": "#888888", "$type": "color" }
        },
        "interactive": {
          "primary": { "$value": "{primitive.color.neutral.800}", "$type": "color" },
          "primary-foreground": { "$value": "{primitive.color.neutral.0}", "$type": "color" },
          "brand-action": { "$value": "#000000", "$type": "color" },
          "brand-action-hover": { "$value": "#3d3c38", "$type": "color" },
          "brand-action-foreground": { "$value": "{primitive.color.neutral.0}", "$type": "color" },
          "hover": { "$value": "{primitive.color.alpha.black-3}", "$type": "color" },
          "selected": { "$value": "{primitive.color.neutral.150}", "$type": "color" },
          "focus": { "$value": "{primitive.color.chromatic.teal}", "$type": "color" }
        },
        "status": {
          "info": { "$value": "{primitive.color.chromatic.teal}", "$type": "color" },
          "success": { "$value": "{primitive.color.chromatic.green}", "$type": "color" },
          "warning": { "$value": "{primitive.color.chromatic.amber}", "$type": "color" },
          "danger": { "$value": "{primitive.color.chromatic.red}", "$type": "color" }
        }
      }
    },
    "dark": {
      "color": {
        "background": { "$value": "{primitive.color.neutral.950}", "$type": "color" },
        "foreground": { "$value": "#f7f7f3", "$type": "color" },
        "surface": {
          "canvas": { "$value": "{primitive.color.neutral.950}", "$type": "color" },
          "content": { "$value": "{primitive.color.neutral.950}", "$type": "color" },
          "raised": { "$value": "#151516", "$type": "color" },
          "panel": { "$value": "#151516", "$type": "color" },
          "recessed": { "$value": "#101011", "$type": "color" },
          "control": { "$value": "{primitive.color.alpha.white-10}", "$type": "color" },
          "control-hover": { "$value": "{primitive.color.alpha.white-16}", "$type": "color" },
          "sidebar": { "$value": "rgba(20, 20, 22, 0.15)", "$type": "color" },
          "chrome": { "$value": "rgba(31, 32, 34, 0.44)", "$type": "color" }
        },
        "text": {
          "primary": { "$value": "#f7f7f3", "$type": "color" },
          "secondary": { "$value": "#b8b8b2", "$type": "color" },
          "muted": { "$value": "#9a9a94", "$type": "color" },
          "inverse": { "$value": "{primitive.color.neutral.900}", "$type": "color" },
          "link": { "$value": "#72a8b4", "$type": "color" }
        },
        "border": {
          "default": { "$value": "#1d1d1d", "$type": "color" },
          "subtle": { "$value": "{primitive.color.alpha.white-8}", "$type": "color" },
          "muted": { "$value": "{primitive.color.alpha.white-6}", "$type": "color" },
          "strong": { "$value": "rgba(255, 255, 255, 0.13)", "$type": "color" }
        },
        "icon": {
          "default": { "$value": "#b7b7b0", "$type": "color" },
          "muted": { "$value": "#969690", "$type": "color" }
        },
        "interactive": {
          "primary": { "$value": "#f7f7f3", "$type": "color" },
          "primary-foreground": { "$value": "{primitive.color.neutral.900}", "$type": "color" },
          "brand-action": { "$value": "#f5f1ec", "$type": "color" },
          "brand-action-hover": { "$value": "#e6ded5", "$type": "color" },
          "brand-action-foreground": { "$value": "#11100f", "$type": "color" },
          "hover": { "$value": "rgba(255, 255, 255, 0.055)", "$type": "color" },
          "selected": { "$value": "rgba(255, 255, 255, 0.08)", "$type": "color" },
          "focus": { "$value": "#72a8b4", "$type": "color" }
        },
        "status": {
          "info": { "$value": "#72a8b4", "$type": "color" },
          "success": { "$value": "#55a67c", "$type": "color" },
          "warning": { "$value": "#d49a56", "$type": "color" },
          "danger": { "$value": "#d97368", "$type": "color" }
        }
      }
    }
  },
  "typography": {
    "caption": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "11px", "fontWeight": 400, "lineHeight": 1.35, "letterSpacing": "0.01em" }, "$type": "typography" },
    "label": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "12px", "fontWeight": 500, "lineHeight": 1.35, "letterSpacing": "0em" }, "$type": "typography" },
    "body-sm": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.45, "letterSpacing": "0em" }, "$type": "typography" },
    "body": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "-0.005em" }, "$type": "typography" },
    "title-sm": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "16px", "fontWeight": 500, "lineHeight": 1.35, "letterSpacing": "-0.01em" }, "$type": "typography" },
    "title": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "20px", "fontWeight": 500, "lineHeight": 1.25, "letterSpacing": "-0.015em" }, "$type": "typography" },
    "heading": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "24px", "fontWeight": 500, "lineHeight": 1.2, "letterSpacing": "-0.02em" }, "$type": "typography" },
    "display": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "32px", "fontWeight": 500, "lineHeight": 1.12, "letterSpacing": "-0.025em" }, "$type": "typography" },
    "code": { "$value": { "fontFamily": "{primitive.fontFamily.mono}", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0em" }, "$type": "typography" }
  },
  "spacing": {
    "0": { "$value": "{primitive.dimension.0}", "$type": "dimension" },
    "1": { "$value": "{primitive.dimension.4}", "$type": "dimension" },
    "2": { "$value": "{primitive.dimension.8}", "$type": "dimension" },
    "3": { "$value": "{primitive.dimension.12}", "$type": "dimension" },
    "4": { "$value": "{primitive.dimension.16}", "$type": "dimension" },
    "5": { "$value": "{primitive.dimension.20}", "$type": "dimension" },
    "6": { "$value": "{primitive.dimension.24}", "$type": "dimension" },
    "8": { "$value": "{primitive.dimension.32}", "$type": "dimension" },
    "10": { "$value": "{primitive.dimension.40}", "$type": "dimension" },
    "12": { "$value": "{primitive.dimension.48}", "$type": "dimension" },
    "16": { "$value": "{primitive.dimension.64}", "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "{primitive.dimension.0}", "$type": "dimension" },
    "control": { "$value": "{primitive.dimension.2}", "$type": "dimension" },
    "row": { "$value": "{primitive.dimension.4}", "$type": "dimension" },
    "card": { "$value": "{primitive.dimension.8}", "$type": "dimension" },
    "dialog": { "$value": "{primitive.dimension.12}", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "hairline": { "$value": "0 0 0 1px rgba(15, 23, 42, 0.052)", "$type": "shadow" },
    "popover": { "$value": "0 12px 32px rgba(17, 17, 17, 0.10), 0 2px 8px rgba(17, 17, 17, 0.06)", "$type": "shadow" },
    "dialog": { "$value": "0 24px 64px rgba(17, 17, 17, 0.16), 0 4px 16px rgba(17, 17, 17, 0.08)", "$type": "shadow" }
  },
  "layout": {
    "sidebar-width": { "$value": "240px", "$type": "dimension" },
    "titlebar-height": { "$value": "36px", "$type": "dimension" },
    "sidebar-row-height": { "$value": "30px", "$type": "dimension" },
    "control-height-compact": { "$value": "{primitive.dimension.28}", "$type": "dimension" },
    "control-height-sm": { "$value": "{primitive.dimension.28}", "$type": "dimension", "$description": "Compatibility alias for compact controls." },
    "control-height": { "$value": "{primitive.dimension.36}", "$type": "dimension" },
    "control-height-lg": { "$value": "{primitive.dimension.40}", "$type": "dimension" },
    "compact-row-height": { "$value": "{primitive.dimension.44}", "$type": "dimension" },
    "content-max-width": { "$value": "1200px", "$type": "dimension" }
  },
  "motion": {
    "duration": {
      "instant": { "$value": "{primitive.duration.instant}", "$type": "duration" },
      "fast": { "$value": "{primitive.duration.fast}", "$type": "duration" },
      "normal": { "$value": "{primitive.duration.normal}", "$type": "duration" },
      "slow": { "$value": "{primitive.duration.slow}", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "{primitive.cubicBezier.standard}", "$type": "cubicBezier" },
      "exit": { "$value": "{primitive.cubicBezier.exit}", "$type": "cubicBezier" }
    }
  },
  "$extensions": {
    "com.ritual.design-system": {
      "name": "Ritual",
      "version": "0.1.1-reference",
      "status": "provisional",
      "source": "Current Ritual desktop styling and @ritual/ui architecture",
      "updatedAt": "2026-07-15"
    }
  }
}
