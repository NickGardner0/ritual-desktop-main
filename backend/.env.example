# =============================================================================
# Ritual Python Backend - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# =============================================================================
# CLERK AUTHENTICATION (Required)
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_here

# =============================================================================
# DATABASE (Required)
# =============================================================================
# Local SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./ritual.db

# Turso Cloud (production):
# DATABASE_URL=libsql://your-database.turso.io?authToken=your_auth_token

# =============================================================================
# TINYBIRD ANALYTICS (Required)
# =============================================================================
TINYBIRD_ENV=cloud
TINYBIRD_API_URL=https://api.us-east.aws.tinybird.co
TINYBIRD_TOKEN=your_tinybird_admin_token_here

# Local Tinybird (optional):
# TINYBIRD_ENV=local
# TINYBIRD_LOCAL_URL=http://localhost:7181
# TINYBIRD_LOCAL_TOKEN=admin local_testing@tinybird.co

# =============================================================================
# WHOOP INTEGRATION (Optional)
# =============================================================================
WHOOP_CLIENT_ID=your_whoop_client_id
WHOOP_CLIENT_SECRET=your_whoop_client_secret
NEXT_PUBLIC_WHOOP_REDIRECT_URI=http://localhost:3000/api/integrations/whoop/callback

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=http://localhost:3000,https://localhost:3000,tauri://localhost

# =============================================================================
# INTERNAL SECURITY
# =============================================================================
# Internal API key for protected endpoints (generate a random string)
INTERNAL_API_KEY=generate_a_random_secure_string_here

# JWT secret for custom tokens (generate a random string)
JWT_SECRET=generate_a_random_secure_string_here
