DESCRIPTION >
    Get user's habit summary with completion stats and time-based comparisons
    Shows current metrics and percentage changes over time
    DEDUPLICATES by id to handle re-synced Apple Health data

NODE deduplicated_logs
SQL >
    %
    SELECT
        id,
        habit_id,
        habit_name,
        date,
        status,
        duration,
        amount,
        unit,
        created_at
    FROM habit_logs
    WHERE user_id = {{ String(user_id, required=True) }}
      AND date >= today() - INTERVAL 60 DAY
    ORDER BY id, created_at DESC
    LIMIT 1 BY id

NODE habit_stats
SQL >
    %
    SELECT
        habit_id,
        habit_name,
        COUNT(*) as total_logs,
        countIf(status = 'completed') as completed_count,
        countIf(status = 'skipped') as skipped_count,
        SUM(duration) as total_duration_seconds,
        SUM(amount) as total_amount,
        -- Average per day with data (not per entry)
        SUM(amount) / COUNT(DISTINCT date) as avg_amount,
        SUM(duration) / COUNT(DISTINCT date) as avg_duration_per_day,
        COUNT(DISTINCT date) as days_with_data,
        MAX(date) as last_completed_date,
        MIN(date) as first_log_date,
        any(unit) as unit,
        -- Stability metrics
        varPop(amount) as variance_amount,
        stddevPop(amount) as stddev_amount,
        -- Coefficient of variation (stddev/mean) - lower = more stable
        CASE 
            WHEN SUM(amount) / COUNT(DISTINCT date) > 0 
            THEN stddevPop(amount) / (SUM(amount) / COUNT(DISTINCT date))
            ELSE 0
        END as coefficient_of_variation
    FROM deduplicated_logs
    WHERE date >= today() - INTERVAL {{Int32(days_back, 30)}} DAY
    GROUP BY habit_id, habit_name

NODE last_7_days
SQL >
    %
    SELECT
        habit_id,
        habit_name,
        COUNT(*) as count_7d,
        COUNT(DISTINCT date) as days_7d,
        SUM(amount) as amount_7d,
        SUM(duration) as duration_7d,
        -- Average per day with data (not per entry)
        SUM(amount) / COUNT(DISTINCT date) as avg_amount_7d,
        SUM(duration) / COUNT(DISTINCT date) as avg_duration_7d
    FROM deduplicated_logs
    WHERE date >= today() - INTERVAL 7 DAY
      AND status = 'completed'
    GROUP BY habit_id, habit_name

NODE prev_7_days
SQL >
    %
    SELECT
        habit_id,
        COUNT(*) as count_prev_7d,
        COUNT(DISTINCT date) as days_prev_7d,
        SUM(amount) as amount_prev_7d,
        SUM(duration) as duration_prev_7d,
        SUM(amount) / COUNT(DISTINCT date) as avg_amount_prev_7d,
        SUM(duration) / COUNT(DISTINCT date) as avg_duration_prev_7d
    FROM deduplicated_logs
    WHERE date >= today() - INTERVAL 14 DAY
      AND date < today() - INTERVAL 7 DAY
      AND status = 'completed'
    GROUP BY habit_id

NODE last_30_days
SQL >
    %
    SELECT
        habit_id,
        COUNT(*) as count_30d,
        COUNT(DISTINCT date) as days_30d,
        SUM(amount) as amount_30d,
        SUM(duration) as duration_30d,
        SUM(amount) / COUNT(DISTINCT date) as avg_amount_30d,
        SUM(duration) / COUNT(DISTINCT date) as avg_duration_30d
    FROM deduplicated_logs
    WHERE date >= today() - INTERVAL 30 DAY
      AND status = 'completed'
    GROUP BY habit_id

NODE prev_30_days
SQL >
    %
    SELECT
        habit_id,
        COUNT(*) as count_prev_30d,
        COUNT(DISTINCT date) as days_prev_30d,
        SUM(amount) as amount_prev_30d,
        SUM(duration) as duration_prev_30d,
        SUM(amount) / COUNT(DISTINCT date) as avg_amount_prev_30d,
        SUM(duration) / COUNT(DISTINCT date) as avg_duration_prev_30d
    FROM deduplicated_logs
    WHERE date >= today() - INTERVAL 60 DAY
      AND date < today() - INTERVAL 30 DAY
      AND status = 'completed'
    GROUP BY habit_id

NODE summary_with_comparisons
SQL >
    %
    SELECT 
        h.habit_id AS habit_id,
        h.habit_name AS habit_name,
        h.unit AS unit,
        h.total_logs AS total_logs,
        h.completed_count AS completed_count,
        h.skipped_count AS skipped_count,
        h.total_amount AS total_amount,
        h.avg_amount AS avg_amount,
        h.avg_duration_per_day AS avg_duration_per_day,
        h.days_with_data AS days_with_data,
        h.last_completed_date AS last_completed_date,
        h.first_log_date AS first_log_date,
        
        -- Last 7 days metrics
        l7.count_7d as last_7_days_count,
        l7.days_7d as last_7_days_with_data,
        l7.amount_7d as last_7_days_amount,
        l7.avg_amount_7d as last_7_days_avg,
        l7.avg_duration_7d as last_7_days_avg_duration,
        p7.count_prev_7d as prev_7_days_count,
        p7.days_prev_7d as prev_7_days_with_data,
        p7.avg_amount_prev_7d as prev_7_days_avg,
        
        -- 7-day changes (based on days with data, not entries)
        l7.days_7d - p7.days_prev_7d as weekly_days_change,
        CASE 
            WHEN p7.days_prev_7d > 0 
            THEN ((l7.days_7d - p7.days_prev_7d) / p7.days_prev_7d * 100) 
            ELSE 0 
        END as weekly_days_change_pct,
        
        CASE 
            WHEN p7.avg_amount_prev_7d > 0 
            THEN ((l7.avg_amount_7d - p7.avg_amount_prev_7d) / p7.avg_amount_prev_7d * 100) 
            ELSE 0 
        END as weekly_amount_change_pct,
        
        -- Last 30 days metrics
        l30.count_30d as last_30_days_count,
        l30.days_30d as last_30_days_with_data,
        l30.amount_30d as last_30_days_amount,
        l30.avg_amount_30d as last_30_days_avg,
        l30.avg_duration_30d as last_30_days_avg_duration,
        p30.count_prev_30d as prev_30_days_count,
        p30.days_prev_30d as prev_30_days_with_data,
        p30.avg_amount_prev_30d as prev_30_days_avg,
        
        -- 30-day changes
        l30.days_30d - p30.days_prev_30d as monthly_days_change,
        CASE 
            WHEN p30.days_prev_30d > 0 
            THEN ((l30.days_30d - p30.days_prev_30d) / p30.days_prev_30d * 100) 
            ELSE 0 
        END as monthly_days_change_pct,
        
        CASE 
            WHEN p30.avg_amount_prev_30d > 0 
            THEN ((l30.avg_amount_30d - p30.avg_amount_prev_30d) / p30.avg_amount_prev_30d * 100) 
            ELSE 0 
        END as monthly_amount_change_pct,
        
        -- Stability metrics
        h.variance_amount,
        h.stddev_amount,
        h.coefficient_of_variation,
        -- Consistency score (percentage of days in period with data)
        round((h.days_with_data / {{Int32(days_back, 30)}}) * 100, 1) as consistency_score,
        -- Stability classification
        CASE
            WHEN h.coefficient_of_variation < 0.3 THEN 'stable'
            WHEN h.coefficient_of_variation < 0.6 THEN 'moderate'
            ELSE 'variable'
        END as stability_class
        
    FROM habit_stats h
    LEFT JOIN last_7_days l7 ON h.habit_id = l7.habit_id
    LEFT JOIN prev_7_days p7 ON h.habit_id = p7.habit_id
    LEFT JOIN last_30_days l30 ON h.habit_id = l30.habit_id
    LEFT JOIN prev_30_days p30 ON h.habit_id = p30.habit_id
    ORDER BY h.last_completed_date DESC

TYPE ENDPOINT
