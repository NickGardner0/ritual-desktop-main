{
  "name": "ritual",
  "version": "1.0.0",
  "description": "Ritual Monorepo - Desktop + iOS Companion + Backend",
  "private": true,
  "packageManager": "npm@11.0.0",
  "workspaces": [
    "apps/dashboard",
    "apps/browser-extension",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/dashboard && next dev -p 3000 --turbo",
    "dev:backend": "cd apps/backend && python3 -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "typecheck": "cd apps/dashboard && NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit --pretty false",
    "test:dashboard:snapshots": "node --test apps/dashboard/tests/weekly-overview-utils.test.mjs",
    "contracts:build": "npm run --workspace @ritual/shared-contracts build",
    "contracts:typecheck": "npm run --workspace @ritual/shared-contracts typecheck",
    "dev:webpack": "cd apps/dashboard && next dev -p 3000",
    "build": "npm run typecheck && cd apps/dashboard && NODE_OPTIONS='--max-old-space-size=8192' next build --webpack",
    "start": "cd apps/dashboard && next start -p 3000",
    "lint": "cd apps/dashboard && eslint .",
    "tauri": "cd apps/desktop && tauri",
    "tauri:dev": "cd apps/desktop && tauri dev",
    "tauri:build": "npm run typecheck && cd apps/desktop && tauri build",
    "desktop:updater:config": "node scripts/write-tauri-production-config.mjs",
    "desktop:release:preflight": "bash scripts/validate-macos-release-env.sh",
    "desktop:release:mac": "bash scripts/build-macos-desktop-release.sh",
    "desktop:release:validate-updater": "node scripts/validate-updater-artifacts.mjs",
    "desktop": "echo '⚡ Make sure Next.js is running on port 3000 first (npm run dev)' && cd apps/desktop && tauri dev",
    "desktop:clean": "pkill -f '/target/debug/ritual-desktop' || true; pkill -f 'ritual-watcher --device-id' || true; pkill -f 'ritual-recorder --database' || true",
    "desktop:fresh": "npm run desktop:clean && npm run desktop",
    "desktop:prod": "npm run build && npm run start & sleep 3 && cd apps/desktop && tauri dev",
    "trigger:dev": "cd apps/dashboard && npx trigger.dev@latest dev",
    "trigger:deploy": "npm run typecheck && cd apps/dashboard && npx trigger.dev@latest deploy",
    "trigger:deploy:prod": "npm run typecheck && cd apps/dashboard && npx trigger.dev@latest deploy --env prod",
    "repo:check": "bash scripts/check-repo-structure.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.31",
    "@ai-sdk/react": "^2.0.98",
    "@clerk/nextjs": "^6.35.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@mui/icons-material": "^7.3.4",
    "@next/swc-darwin-arm64": "^16.1.4",
    "@openpanel/nextjs": "^1.1.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^1.6.0",
    "@types/xml2js": "^0.4.14",
    "ai": "^5.0.106",
    "ai-sdk-tools": "^0.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "^3.6.0",
    "fast-xml-parser": "^5.3.3",
    "framer-motion": "^12.23.25",
    "geist": "^1.5.1",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.553.0",
    "minisearch": "^7.2.0",
    "next": "^16.0.3",
    "next-themes": "^0.4.6",
    "openai": "^4.104.0",
    "react": "^19.0.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.1",
    "react-hotkeys-hook": "^5.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.1",
    "streamdown": "^1.6.9",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tauri-plugin-context-menu": "^0.8.0",
    "unicode-animations": "^1.0.3",
    "usehooks-ts": "^3.1.1",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.3",
    "@sentry/nextjs": "^10.23.0",
    "@shadcn/ui": "^0.0.4",
    "@tauri-apps/cli": "^1.6.3",
    "@trigger.dev/build": "4.0.6",
    "@trigger.dev/sdk": "4.0.6",
    "@types/node": "^22",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/recharts": "^1.8.29",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.3",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.0",
    "typescript": "5.8.2"
  }
}
