{
  "name": "ritual",
  "version": "1.0.0",
  "description": "Ritual Monorepo - Desktop + iOS Companion + Backend",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev -p 3000 --turbo",
    "dev:backend": "cd backend && python3 -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "contracts:build": "cd packages/shared-contracts && pnpm build",
    "contracts:typecheck": "cd packages/shared-contracts && pnpm typecheck",
    "dev:webpack": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "desktop": "echo '⚡ Make sure Next.js is running on port 3000 first (npm run dev)' && tauri dev",
    "desktop:prod": "npm run build && npm run start & sleep 3 && tauri dev",
    "trigger:dev": "npx trigger.dev@latest dev",
    "trigger:deploy": "npx trigger.dev@latest deploy",
    "trigger:deploy:prod": "npx trigger.dev@latest deploy --env prod"
  },
