{
  "name": "ritual",
  "version": "1.0.0",
  "description": "Ritual Monorepo - Desktop + iOS Companion + Backend",
  "private": true,
  "packageManager": "npm@11.0.0",
  "workspaces": [
    "apps/dashboard",
    "apps/desktop-ui",
    "apps/browser-extension",
    "packages/*"
  ],
  "scripts": {
    "typecheck:ui": "npm run --workspace @ritual/ui typecheck",
    "build:chat-runtime": "npm run --workspace @ritual/chat-runtime build",
    "dev:desktop-ui": "npm run --workspace @ritual/desktop-ui dev",
    "dev": "npm run build:chat-runtime && cd apps/dashboard && next dev -p 3000 --turbo",
    "dev:backend": "cd apps/backend && python3 -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "typecheck": "npm run contracts:build && npm run build:chat-runtime && cd apps/dashboard && NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit --pretty false",
    "test:dashboard:snapshots": "node --test apps/dashboard/tests/weekly-overview-utils.test.mjs",
    "test:dashboard:orchestrator": "node --test apps/dashboard/tests/chat-stream-orchestrator.test.mjs",
    "test:dashboard": "node --test apps/dashboard/tests/*.test.mjs apps/desktop-ui/tests/*.test.mjs",
    "contracts:build": "npm run --workspace @ritual/shared-contracts build",
    "contracts:typecheck": "npm run --workspace @ritual/shared-contracts typecheck",
    "api:openapi": "node scripts/backend-python.mjs -- scripts/export-backend-openapi.py --output apps/backend/openapi.json",
    "api:generate-client": "node scripts/generate-backend-client.mjs --input apps/backend/openapi.json --output apps/dashboard/lib/api/generated/backend-client.ts",
    "backend:compile": "node scripts/backend-python.mjs -- -m compileall -q apps/backend",
    "backend:test": "RITUAL_DB_LOCAL_ONLY=1 DATABASE_URL='libsql://ci.turso.io?authToken=test' node scripts/backend-python.mjs -- -m pytest -q apps/backend/tests",
    "ops:scheduler:health": "node scripts/check-scheduler-health.mjs",
    "test:chat-failure-injection": "npm run --workspace @ritual/chat-runtime build && NODE_ENV=test RITUAL_ASSISTANT_TURN_STORE=memory node --test packages/chat-runtime/tests/assistant-failure-injection.test.mjs",
    "test:auth-handoff:e2e": "RITUAL_DB_LOCAL_ONLY=1 DATABASE_URL='libsql://ci.turso.io?authToken=test' node scripts/backend-python.mjs -- -m pytest -q apps/backend/tests/test_desktop_auth_handoff*.py",
    "backend:lock": "node scripts/lock-backend-python.mjs",
    "dev:webpack": "npm run build:chat-runtime && cd apps/dashboard && next dev -p 3000",
    "build": "npm run typecheck && cd apps/dashboard && NODE_OPTIONS='--max-old-space-size=8192' next build --webpack && cd ../.. && node scripts/normalize-next-proxy-output.mjs",
    "start": "cd apps/dashboard && next start -p 3000",
    "lint": "cd apps/dashboard && eslint .",
    "tauri": "cd apps/desktop && tauri",
    "tauri:dev": "cd apps/desktop && RITUAL_CHANNEL=development RITUAL_ENV=development tauri dev --config src-tauri/tauri.dev.conf.json --features qa-tools",
    "tauri:qa": "cd apps/desktop && RITUAL_CHANNEL=qa RITUAL_ENV=staging tauri dev --config src-tauri/tauri.qa.conf.json --features qa-tools",
    "tauri:build": "npm run typecheck && cd apps/desktop && RITUAL_CHANNEL=production RITUAL_ENV=production tauri build",
    "tauri:build:qa": "npm run typecheck && cd apps/desktop && RITUAL_CHANNEL=qa RITUAL_ENV=staging tauri build --config src-tauri/tauri.qa.conf.json --features qa-tools",
    "desktop:updater:config": "node scripts/write-tauri-production-config.mjs",
    "desktop:release:preflight": "bash scripts/validate-macos-release-env.sh",
    "desktop:release:mac": "bash scripts/build-macos-desktop-release.sh",
    "desktop:release:validate-updater": "node scripts/validate-updater-artifacts.mjs",
    "desktop:release:dry-run": "node scripts/check-desktop-release-target.mjs",
    "desktop:diagnostics": "node scripts/desktop-diagnostics.mjs",
    "desktop:qa:capture": "node scripts/capture-desktop-window-qa.mjs",
    "test:desktop-release-contract": "node --test tools/desktop/*.test.mjs",
    "desktop:check:browser-extension": "bash scripts/check-browser-extension-health.sh",
    "desktop:check:sidecars": "node scripts/verify-desktop-sidecars.mjs",
    "desktop:sidecars:build": "bash scripts/build-desktop-sidecars.sh",
    "desktop:check:activity-audit": "bash scripts/check-activity-audit.sh",
    "desktop:watcher:seed-qa": "node scripts/seed-watcher-preferences-for-qa.mjs",
    "desktop": "echo '⚡ Make sure Next.js is running on port 3000 first (npm run dev)' && npm run tauri:dev",
    "desktop:clean": "pkill -f '/target/debug/ritual-desktop' || true; pkill -f 'ritual-watcher --device-id' || true",
    "desktop:fresh": "npm run desktop:clean && npm run desktop",
    "desktop:prod": "npm run build && npm run start & sleep 3 && cd apps/desktop && tauri dev",
    "repo:check": "bash scripts/check-repo-structure.sh && node scripts/check-ui-boundary.mjs && node scripts/check-dead-code.mjs && bash scripts/check-removed-recorder.sh && node scripts/check-dashboard-api-budget.mjs && node scripts/check-dashboard-api-manifest.mjs && node scripts/check-runtime-schema-budget.mjs && node scripts/check-backend-ops-manifest.mjs && node scripts/check-backend-ops-smoke.mjs && node scripts/check-migration-boundary.mjs && node scripts/check-generated-backend-client.mjs && node scripts/check-import-cycles.mjs && node scripts/check-chat-runtime-boundaries.mjs && node scripts/check-no-direct-backend-fetch.mjs && node scripts/check-desktop-capabilities-boundary.mjs && node scripts/check-tauri-command-acl.mjs && node scripts/check-dashboard-line-budget.mjs && node scripts/check-rust-line-budget.mjs && node scripts/check-performance-budgets.mjs && node scripts/check-launch-budgets.mjs && node --test tools/performance/launch-budgets.test.mjs tools/performance/watcher-preference-seed.test.mjs tools/desktop/*.test.mjs && node scripts/verify-desktop-sidecars.mjs && node scripts/check-architecture-inventory.mjs && node scripts/audit-production-loc.mjs --check",
    "repo:check:rust-line-budget": "node scripts/check-rust-line-budget.mjs",
    "repo:check:api-client-boundary": "node scripts/check-no-direct-backend-fetch.mjs",
    "repo:check:desktop-capabilities": "node scripts/check-desktop-capabilities-boundary.mjs && node scripts/check-tauri-command-acl.mjs",
    "repo:check:dead-code": "node scripts/check-dead-code.mjs",
    "repo:check:recorder-removed": "bash scripts/check-removed-recorder.sh",
    "repo:check:api-boundary": "node scripts/check-dashboard-api-budget.mjs && node scripts/check-dashboard-api-manifest.mjs",
    "repo:check:schema-boundary": "node scripts/check-runtime-schema-budget.mjs",
    "repo:check:ops-manifest": "node scripts/check-backend-ops-manifest.mjs && node scripts/check-backend-ops-smoke.mjs",
    "repo:check:migration-boundary": "node scripts/check-migration-boundary.mjs",
    "repo:check:generated-client": "node scripts/check-generated-backend-client.mjs",
    "repo:check:architecture-inventory": "node scripts/check-architecture-inventory.mjs",
    "audit:loc": "node scripts/audit-production-loc.mjs",
    "audit:loc:check": "node scripts/audit-production-loc.mjs --check",
    "repo:check:dashboard-line-budget": "node scripts/check-dashboard-line-budget.mjs && node scripts/check-performance-budgets.mjs",
    "repo:check:import-cycles": "node scripts/check-import-cycles.mjs",
    "repo:check:chat-runtime-boundary": "node scripts/check-chat-runtime-boundaries.mjs",
    "privacy:verify": "node scripts/verify-privacy-guardrails.mjs",
    "smoke:prod:read-models": "node scripts/smoke-production-read-models.mjs",
    "perf:baseline": "node scripts/collect-performance-baseline.mjs",
    "perf:runtime": "node scripts/measure-runtime-performance.mjs",
    "perf:launch:capture": "node scripts/capture-desktop-launch-evidence.mjs",
    "perf:launch:release-check": "RITUAL_REQUIRE_LIVE_LAUNCH_EVIDENCE=1 node scripts/check-launch-budgets.mjs",
    "repo:clean-local": "bash scripts/clean-local-artifacts.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.31",
    "@clerk/nextjs": "^7.0.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mui/icons-material": "^7.3.4",
    "@openpanel/nextjs": "^1.1.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "ai": "^5.0.106",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.23.25",
    "geist": "^1.5.1",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.553.0",
    "minisearch": "^7.2.0",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "openai": "^4.104.0",
    "react": "^19.0.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.0.0",
    "react-hotkeys-hook": "^5.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.1",
    "streamdown": "^1.6.9",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unicode-animations": "^1.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.1",
    "@sentry/nextjs": "^10.23.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^22",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.0",
    "typescript": "5.8.2",
    "vite": "^5.4.18"
  }
}
