DESCRIPTION >
    Aggregated computer activity summary for a user (V3)
    Supports summary, daily totals, top apps, top domains, and per-key daily breakdown.
    This is the canonical aggregate endpoint for computer analytics.

TOKEN "read_computer_activity" READ

NODE daily_totals
DESCRIPTION >
    Calculate daily totals by user (including AFK breakdown)

SQL >
    %
    SELECT 
        user_id,
        day,
        sum(active_ms) as total_active_ms,
        sum(afk_ms) as total_afk_ms,
        sum(events_count) as total_events,
        count(distinct app_bundle_id) as unique_apps,
        uniqExactIf(browser_domain, browser_domain != '' AND browser_domain IS NOT NULL) as unique_domains
    FROM computer_activity_daily
    WHERE user_id = {{ String(user_id, required=True) }}
      AND day >= {{ Date(start_date, required=True) }}
      AND day <= {{ Date(end_date, required=True) }}
    GROUP BY user_id, day
    ORDER BY day ASC

NODE top_apps
DESCRIPTION >
    Get top apps by usage for the period

SQL >
    %
    SELECT 
        user_id,
        app_bundle_id,
        app_name,
        sum(active_ms) as total_active_ms,
        sum(events_count) as total_events,
        count(distinct day) as days_used
    FROM computer_activity_daily
    WHERE user_id = {{ String(user_id, required=True) }}
      AND day >= {{ Date(start_date, required=True) }}
      AND day <= {{ Date(end_date, required=True) }}
    GROUP BY user_id, app_bundle_id, app_name
    ORDER BY total_active_ms DESC
    LIMIT {{ Int32(limit, 10) }}

NODE top_domains
DESCRIPTION >
    Get top browser domains by usage for the period

SQL >
    %
    SELECT 
        user_id,
        browser_domain,
        sum(active_ms) as total_active_ms,
        sum(events_count) as total_events,
        count(distinct day) as days_used
    FROM computer_activity_daily
    WHERE user_id = {{ String(user_id, required=True) }}
      AND day >= {{ Date(start_date, required=True) }}
      AND day <= {{ Date(end_date, required=True) }}
      AND browser_domain != ''
      AND browser_domain IS NOT NULL
    GROUP BY user_id, browser_domain
    ORDER BY total_active_ms DESC
    LIMIT {{ Int32(limit, 10) }}

NODE summary
DESCRIPTION >
    Overall summary statistics including AFK and browser metrics

SQL >
    %
    SELECT 
        user_id,
        sum(active_ms) as total_active_ms,
        sum(afk_ms) as total_afk_ms,
        sum(events_count) as total_events,
        count(distinct app_bundle_id) as unique_apps,
        uniqExactIf(browser_domain, browser_domain != '' AND browser_domain IS NOT NULL) as unique_domains,
        count(distinct day) as days_tracked,
        if(count(distinct day) > 0, sum(active_ms) / count(distinct day), 0) as avg_daily_ms
    FROM computer_activity_daily
    WHERE user_id = {{ String(user_id, required=True) }}
      AND day >= {{ Date(start_date, required=True) }}
      AND day <= {{ Date(end_date, required=True) }}
    GROUP BY user_id

NODE usage_breakdown
DESCRIPTION >
    Daily breakdown for one app (by bundle_id/name) or one website domain

SQL >
    %
    SELECT
        day,
        sum(active_ms) as active_ms,
        sum(events_count) as events_count,
        min(first_start_ms) as first_start_ms,
        max(last_end_ms) as last_end_ms
    FROM computer_activity_daily
    WHERE user_id = {{ String(user_id, required=True) }}
      AND day >= {{ Date(start_date, required=True) }}
      AND day <= {{ Date(end_date, required=True) }}
      AND (
        (
          {{ String(kind, 'app') }} = 'app'
          AND (
            app_bundle_id = {{ String(key, '') }}
            OR app_name = {{ String(key, '') }}
          )
        )
        OR (
          {{ String(kind, 'app') }} = 'website'
          AND browser_domain = {{ String(key, '') }}
        )
      )
    GROUP BY day
    ORDER BY day ASC

NODE endpoint
TYPE ENDPOINT
SQL >
    %
    {% if String(output, 'summary') == 'daily' %}
        SELECT * FROM daily_totals
    {% elif String(output, 'summary') == 'apps' %}
        SELECT * FROM top_apps
    {% elif String(output, 'summary') == 'domains' %}
        SELECT * FROM top_domains
    {% elif String(output, 'summary') == 'breakdown' %}
        SELECT * FROM usage_breakdown
    {% else %}
        SELECT * FROM summary
    {% end %}
