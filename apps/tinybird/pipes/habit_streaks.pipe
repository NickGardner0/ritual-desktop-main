DESCRIPTION >
    Calculate current and longest streaks for a specific habit
    Shows consecutive days where the habit was completed

NODE habit_completed_dates
SQL >
    %
    SELECT DISTINCT
        toDate(date) as log_date
    FROM habit_logs
    WHERE user_id = {{ String(user_id, required=True) }}
      AND habit_id = {{ String(habit_id, required=True) }}
      AND status = 'completed'
    ORDER BY log_date DESC

NODE current_streak
SQL >
    %
    WITH 
        recent_dates AS (
            SELECT log_date
            FROM habit_completed_dates
            ORDER BY log_date DESC
            LIMIT 100
        ),
        date_diffs AS (
            SELECT 
                log_date,
                dateDiff('day', log_date, today()) as days_from_today
            FROM recent_dates
        )
    SELECT 
        countIf(days_from_today <= (SELECT min(days_from_today) + count(*) - 1 FROM date_diffs)) as current_streak
    FROM date_diffs

NODE longest_streak
SQL >
    %
    WITH
        all_dates AS (
            SELECT log_date
            FROM habit_completed_dates
            ORDER BY log_date ASC
        ),
        date_numbers AS (
            SELECT 
                log_date,
                toInt32(log_date) - rowNumberInAllBlocks() as streak_group
            FROM all_dates
        ),
        streak_lengths AS (
            SELECT 
                streak_group,
                count(*) as streak_length
            FROM date_numbers
            GROUP BY streak_group
        )
    SELECT 
        max(streak_length) as longest_streak
    FROM streak_lengths

NODE final_result
SQL >
    %
    SELECT
        c.current_streak,
        l.longest_streak,
        if(c.current_streak >= 7, floor(c.current_streak / 7), 0) as weekly_streaks_count,
        if(c.current_streak >= 30, floor(c.current_streak / 30), 0) as monthly_streaks_count
    FROM current_streak c
    CROSS JOIN longest_streak l

TYPE ENDPOINT
