# ==============================================================================
# RITUAL DESKTOP - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy to .env.local and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED - Core functionality
# ------------------------------------------------------------------------------

# Clerk Authentication (https://dashboard.clerk.com/)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxx

# Python Backend URL
NEXT_PUBLIC_PYTHON_API_URL=https://api.yourdomain.com
PYTHON_API_URL=https://api.yourdomain.com
CORS_ALLOW_ORIGIN=tauri://localhost

# Cloud memory uploader (desktop)
# If omitted, desktop defaults to enabled and web defaults to disabled.
NEXT_PUBLIC_RITUAL_MEMORY_CLOUD_ENABLED=true
NEXT_PUBLIC_RITUAL_MEMORY_CLOUD_UPLOADER=true

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# Tinybird (https://app.tinybird.co/)
TINYBIRD_TOKEN=p.xxxxxxxxxxxxx
TINYBIRD_API_URL=https://api.us-east.aws.tinybird.co
TINYBIRD_LOCAL_TOKEN=

# Database - Turso (https://turso.tech/)
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# ------------------------------------------------------------------------------
# WHOOP INTEGRATION (if using)
# ------------------------------------------------------------------------------

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
NEXT_PUBLIC_WHOOP_CLIENT_ID=
NEXT_PUBLIC_WHOOP_REDIRECT_URI=https://yourdomain.com/api/integrations/whoop/callback

# TESLA INTEGRATION (if using)
# ------------------------------------------------------------------------------

NEXT_PUBLIC_TESLA_CLIENT_ID=
NEXT_PUBLIC_TESLA_REDIRECT_URI=https://yourdomain.com/api/integrations/tesla/callback

# ------------------------------------------------------------------------------
# OPTIONAL - Enhanced features
# ------------------------------------------------------------------------------

# OpenPanel Analytics
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_SECRET_KEY=

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=

# Groq (alternative transcription)
GROQ_API_KEY=

# Internal API Key (generate with: openssl rand -base64 32)
INTERNAL_API_KEY=

# Backend token encryption key (generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# Trigger.dev
TRIGGER_SECRET_KEY=
