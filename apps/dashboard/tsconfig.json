{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "es6"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@ritual/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@ritual/ui/cn": [
        "../../packages/ui/src/cn.ts"
      ],
      "@ritual/ui/*": [
        "../../packages/ui/src/components/*"
      ],
      "@ritual/shared-contracts/*": [
        "../../packages/shared-contracts/src/*"
      ],
      "@ritual/chat-runtime/weekly-overview-utils": [
        "../../packages/chat-runtime/src/weekly-overview-utils.ts"
      ],
      "@ritual/chat-runtime/stream-response": [
        "../../packages/chat-runtime/src/stream-response.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/types",
    ".next/dev/types"
  ]
}
