{
  "name": "@ritual/chat-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run --workspace @ritual/chat-runtime build && tsx watch src/server.ts",
    "build": "npm run --workspace @ritual/chat-runtime build && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "npm run --workspace @ritual/chat-runtime build && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@ritual/chat-runtime": "file:../../packages/chat-runtime",
    "hono": "^4.6.10",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
