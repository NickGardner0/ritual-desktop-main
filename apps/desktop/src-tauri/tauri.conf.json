{
  "$schema": "../../../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "http://localhost:3000",
    "distDir": "../../dashboard/.next",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "ritual-desktop",
    "version": "0.1.0"
  },
  "tauri": {
    "macOSPrivateApi": true,
    "allowlist": {
      "all": false,
      "clipboard": {
        "all": true,
        "writeText": true,
        "readText": true
      },
      "shell": {
        "all": false,
        "open": true
      },
      "protocol": {
        "all": true,
        "asset": true,
        "assetScope": [
          "$HOME/.ritual/**",
          "$HOME/.ritual/thumbnails/**",
          "$HOME/.ritual/video/**"
        ]
      },
      "dialog": {
        "all": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "scope": [
          "$HOME/.ritual/**",
          "$DOWNLOAD/*",
          "$DOCUMENT/*",
          "$DESKTOP/*"
        ]
      },
      "path": {
        "all": true
      },
      "process": {
        "all": false,
        "relaunch": true,
        "exit": false
      },
      "window": {
        "all": false,
        "create": true,
        "center": true,
        "requestUserAttention": true,
        "setResizable": true,
        "setTitle": true,
        "maximize": true,
        "unmaximize": true,
        "minimize": true,
        "unminimize": true,
        "show": true,
        "hide": true,
        "close": true,
        "setDecorations": true,
        "setAlwaysOnTop": true,
        "setSize": true,
        "setMinSize": true,
        "setMaxSize": true,
        "setPosition": true,
        "setFullscreen": true,
        "setFocus": true,
        "setIcon": true,
        "setSkipTaskbar": true,
        "setCursorGrab": true,
        "setCursorVisible": true,
        "setCursorIcon": true,
        "setCursorPosition": true,
        "setIgnoreCursorEvents": true,
        "startDragging": true,
        "print": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Productivity",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "externalBin": [
        "binaries/ritual-watcher"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/Ritual.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.ritual.desktop",
      "longDescription": "",
      "macOS": {
        "entitlements": "src-tauri/entitlements.plist",
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": "Developer ID Application: NICHOLAS,ALEXANDER GARDNER (D657T2LVR2)"
      },
      "resources": [],
      "shortDescription": "",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "dangerousRemoteDomainIpcAccess": [
        {
          "scheme": "https",
          "domain": "desktop.ritualdb.com",
          "windows": ["main", "sidebar"],
          "enableTauriAPI": true
        },
        {
          "scheme": "https",
          "domain": "ritual-desktop.vercel.app",
          "windows": ["main", "sidebar"],
          "enableTauriAPI": true
        },
        {
          "scheme": "http",
          "domain": "localhost",
          "windows": ["main", "sidebar"],
          "enableTauriAPI": true
        },
        {
          "scheme": "http",
          "domain": "127.0.0.1",
          "windows": ["main", "sidebar"],
          "enableTauriAPI": true
        }
      ],
      "csp": "default-src 'self'; connect-src 'self' https://api.us-east.aws.tinybird.co https://api.ritual.app https://api.clerk.com https://*.clerk.accounts.dev http://localhost:3000 http://127.0.0.1:3000 http://localhost:8000 http://127.0.0.1:8000 ws://localhost:3000 ws://127.0.0.1:3000; img-src 'self' asset: data: blob: https:; media-src 'self' asset: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/NickGardner0/ritual-desktop-main/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2QjBCMjlGMjgxMDZFNQpSV1RsQm9IeUtRdHJETnZrdkdGMk91bzJ3dy9yYXdHT0hqOTRoUVRoT05JZzdTY1FvWHZEeGlIbQo="
    },
    "systemTray": {
      "iconPath": "icons/tray-iconTemplate@2x.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    },
    "windows": [
      {
        "label": "main",
        "userAgent": "RitualDesktop/0.1.0",
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "",
        "width": 1150,
        "minHeight": 450,
        "minWidth": 800,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "visible": false
      }
    ]
  }
}
