# ==============================================================================
# RITUAL BACKEND - ENVIRONMENT VARIABLES
# ==============================================================================

# Database (Turso)
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token
TURSO_PLATFORM_API_TOKEN=
TURSO_ORGANIZATION=
TURSO_GROUP=
TURSO_DATABASE_PREFIX=ritual_user
TURSO_MIGRATION_GATE_USER_ID=
TURSO_MIGRATION_SOURCE_USER_ID=
TURSO_MIGRATION_SOURCE_DB_PATH=

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxx
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Tinybird Analytics
TINYBIRD_TOKEN=p.xxxxxxxxxxxxx
TINYBIRD_API_URL=https://api.us-east.aws.tinybird.co
TINYBIRD_ENV=cloud
TINYBIRD_LOCAL_TOKEN=

# Whoop Integration (if using)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
NEXT_PUBLIC_WHOOP_REDIRECT_URI=https://yourdomain.com/api/integrations/whoop/callback
WHOOP_API_MAX_RETRIES=3
WHOOP_API_RETRY_BASE_DELAY=0.5

# Tesla Integration (if using)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://yourdomain.com/api/integrations/tesla/callback

# Apple WeatherKit (server-side only)
WEATHERKIT_TEAM_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_SERVICE_ID=
# Can be either full PEM contents (with \\n) OR absolute path to the .p8 file
WEATHERKIT_PRIVATE_KEY_P8=
WEATHERKIT_BASE_URL=https://weatherkit.apple.com/api/v1/weather
WEATHERKIT_LANGUAGE=en
WEATHERKIT_DATASETS=currentWeather,forecastDaily
WEATHER_SYNC_MIN_INTERVAL_SECONDS=600
WEATHER_SYNC_IP_WINDOW_SECONDS=600
WEATHER_SYNC_IP_MAX_REQUESTS=30
WEATHER_LOCATION_BUCKET_PRECISION=2
# Optional analytics forwarding to Tinybird datasource `weather_observations`
WEATHER_FORWARD_TINYBIRD=false

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Security
INTERNAL_API_KEY=your-secure-random-key
CORS_ORIGINS=https://yourdomain.com,tauri://localhost
TOKEN_ENCRYPTION_KEY=generate-with-python-c-\"from-cryptography-fernet-import-Fernet;print(Fernet.generate_key().decode())\"
TURSO_LOCAL_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# Sendblue iMessage Integration
SENDBLUE_API_KEY=your-sendblue-api-key
SENDBLUE_API_SECRET=your-sendblue-api-secret
SENDBLUE_FROM_NUMBER=+1XXXXXXXXXX
SENDBLUE_WEBHOOK_SECRET=your-webhook-secret

# Plaid (if using financial integrations)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_CLIENT_NAME=Ritual
PLAID_COUNTRY_CODES=US
PLAID_PRODUCTS=transactions
PLAID_DAYS_REQUESTED=730
PLAID_REDIRECT_URI=https://yourdomain.com/integrations
PLAID_WEBHOOK_URL=https://api.yourdomain.com/api/financial/plaid/webhook

# ==============================================================================
# CLOUD MEMORY SEARCH (OpenAI + Turbopuffer + Cohere)
# ==============================================================================
RITUAL_MEMORY_CLOUD_ENABLED=false
RITUAL_MEMORY_PROVIDER=turbopuffer
RITUAL_MEMORY_DB_PATH=
RITUAL_MEMORY_RETENTION_DAYS=90
RITUAL_MEMORY_FAIL_CLOSED=true
RITUAL_MEMORY_SHADOW_MODE=false
RITUAL_MEMORY_SHADOW_SAMPLE_RATE=0.2
RITUAL_MEMORY_WATCHER_ALIASES_ENABLED=false
RITUAL_MEMORY_WATCHER_ALIASES_SUNSET=Wed, 01 Jul 2026 00:00:00 GMT

# Turbopuffer (retrieval)
TURBOPUFFER_API_KEY=
TURBOPUFFER_BASE_URL=https://api.turbopuffer.com
TURBOPUFFER_REGION=us
TURBOPUFFER_NAMESPACE_PREFIX=ritual-prod
TURBOPUFFER_TIMEOUT_SECONDS=8

# OpenAI (embeddings + answer synthesis)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-4.1-mini

# Cohere (reranking primary)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
