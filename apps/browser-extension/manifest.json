{
  "manifest_version": 3,
  "name": "Ritual Browser Tracker",
  "description": "Track your browsing activity with Ritual. Works even when the browser is in the background.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "idle",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*",
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8767/*",
    "http://localhost:8766/*",
    "http://localhost:8767/*"
  ],
  "minimum_chrome_version": "110"
}
